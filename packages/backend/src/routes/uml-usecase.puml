@startuml
title SIPENA Use Case Diagram
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFF
  BorderColor #2F3B52
  ArrowColor #2F3B52
}

actor "Pengguna Publik" as Guest
actor "Pengguna Terautentikasi" as Authenticated
actor Admin
actor Leader
actor Staff
actor "Staff PJ" as StaffPJ
actor Teknisi
actor User

Authenticated <|-- Admin
Authenticated <|-- Leader
Authenticated <|-- Staff
Authenticated <|-- StaffPJ
Authenticated <|-- Teknisi
Authenticated <|-- User

rectangle "SIPENA" {
  package "Autentikasi & Akun" {
    usecase "Login" as UC_Login
    usecase "Register" as UC_Register
    usecase "Reset Password" as UC_ResetPassword
    usecase "Logout" as UC_Logout
    usecase "Lihat Profil" as UC_ViewProfile
    usecase "Ubah Profil" as UC_EditProfile
    usecase "Unggah Foto Profil" as UC_UploadPhoto
    usecase "Ubah Password" as UC_ChangePassword
  }

  package "Inventaris Aset" {
    usecase "Lihat Daftar Aset" as UC_ViewAssets
    usecase "Cari dan Filter Aset" as UC_SearchAssets
    usecase "Lihat Detail Aset" as UC_AssetDetail
    usecase "Tambah Aset" as UC_AddAsset
    usecase "Ubah Aset" as UC_EditAsset
    usecase "Hapus Aset" as UC_DeleteAsset
  }

  package "Peminjaman" {
    usecase "Ajukan Peminjaman" as UC_CreateBorrowing
    usecase "Lihat Daftar Peminjaman" as UC_ViewBorrowing
    usecase "Lihat Detail Peminjaman" as UC_BorrowingDetail
    usecase "Setujui Peminjaman" as UC_ApproveBorrowing
    usecase "Tolak Peminjaman" as UC_RejectBorrowing
    usecase "Catat Pengembalian" as UC_ReturnBorrowing
    usecase "Validasi Pengembalian" as UC_ValidateReturn
    usecase "Ubah Data Peminjaman" as UC_EditBorrowing
  }

  package "Pemeliharaan" {
    usecase "Buat Permintaan Pemeliharaan" as UC_CreateMaintenance
    usecase "Lihat Daftar Pemeliharaan" as UC_ViewMaintenance
    usecase "Lihat Detail Pemeliharaan" as UC_MaintenanceDetail
    usecase "Ubah Pemeliharaan" as UC_EditMaintenance
    usecase "Selesaikan Pemeliharaan" as UC_CompleteMaintenance
    usecase "Validasi Pemeliharaan" as UC_ValidateMaintenance
    usecase "Batalkan Pemeliharaan" as UC_DeleteMaintenance
  }

  package "Jadwal Pemeliharaan" {
    usecase "Buat Jadwal Pemeliharaan" as UC_CreateSchedule
    usecase "Lihat Jadwal Pemeliharaan" as UC_ViewSchedule
    usecase "Lihat Detail Jadwal" as UC_ScheduleDetail
    usecase "Ubah Jadwal Pemeliharaan" as UC_EditSchedule
    usecase "Ubah Status Jadwal" as UC_UpdateScheduleStatus
    usecase "Hapus Jadwal Pemeliharaan" as UC_DeleteSchedule
  }

  package "Laporan & Dokumentasi" {
    usecase "Lihat Dashboard Laporan" as UC_ViewDashboard
    usecase "Lihat Laporan Aset" as UC_AssetReport
    usecase "Lihat Laporan Peminjaman" as UC_BorrowingReport
    usecase "Lihat Laporan Pemeliharaan" as UC_MaintenanceReport
    usecase "Unggah Laporan" as UC_UploadReport
    usecase "Lihat Upload Laporan" as UC_ViewUploads
    usecase "Unduh Upload Laporan" as UC_DownloadUpload
    usecase "Pratinjau Upload Laporan" as UC_PreviewUpload
    usecase "Hapus Upload Laporan" as UC_DeleteUpload
    usecase "Ekspor PDF" as UC_ExportPdf
    usecase "Ekspor Excel" as UC_ExportExcel
    usecase "Lihat Riwayat Aktivitas" as UC_ViewActivity
    usecase "Akses Dokumentasi UML" as UC_ViewUML
  }

  package "Manajemen Pengguna" {
    usecase "Lihat Daftar Pengguna" as UC_ViewUsers
    usecase "Lihat Detail Pengguna" as UC_UserDetail
    usecase "Tambah Pengguna" as UC_AddUser
    usecase "Ubah Pengguna" as UC_EditUser
    usecase "Hapus Pengguna" as UC_DeleteUser
    usecase "Ubah Password Pengguna" as UC_AdminChangePassword
  }
}

Guest --> UC_Login
Guest --> UC_Register
Guest --> UC_ResetPassword

Authenticated --> UC_Logout
Authenticated --> UC_ViewProfile
Authenticated --> UC_EditProfile
Authenticated --> UC_UploadPhoto
Authenticated --> UC_ChangePassword
Authenticated --> UC_ViewActivity
Authenticated --> UC_ViewUML

User --> UC_ViewAssets
User --> UC_SearchAssets
User --> UC_AssetDetail
User --> UC_CreateBorrowing
User --> UC_ViewBorrowing
User --> UC_BorrowingDetail
User --> UC_ReturnBorrowing
User --> UC_ViewDashboard
User --> UC_ViewProfile
