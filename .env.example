# SIPENA monorepo environment
#
# Copy app-specific values from:
# - apps/backend/.env.example
# - apps/frontend/.env.example
# - apps/backend/.docker.env.example for Docker production-like runs
#
# Keep real secrets in local .env files only. Files named .env, .env.local,
# .env.*.local, .docker.env, and .docker.env.local are ignored by git.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sipena_db_local
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_KEEP_ALIVE_INITIAL_DELAY_MS=0

JWT_SECRET=sipena-local-dev-jwt-secret-from-env

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://localhost:4000
