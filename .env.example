# SIPENA monorepo environment
#
# Copy app-specific values from:
# - apps/backend/.env.example
# - apps/frontend/.env.example
# - apps/backend/.docker.env.example for Docker production-like runs
#
# Keep real secrets in local .env files only. Files named .env, .env.local,
# .env.*.local, .docker.env, and .docker.env.local are ignored by git.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sipena_db_local
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_KEEP_ALIVE_INITIAL_DELAY_MS=0

JWT_SECRET=sipena-local-dev-jwt-secret-from-env

# Development-only: expose the DSS debug route and banner status locally.
ALLOW_DSS_DEBUG=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
SSE_TICKET_TTL_SECONDS=30

# Masa berlaku cache dataset SPK (ms). 0 mematikan cache.
DSS_DATASET_CACHE_TTL_MS=60000

# Password reset delivery
# Twilio Verify is the primary OTP channel when all three values are filled in.
# Keep these on the backend only - never expose them with a NEXT_PUBLIC_ prefix.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

# Webhook fallback, used when Twilio Verify is not configured.
# Fill these with credentials from your WhatsApp/SMS gateway. Do not use the
# example URLs or commit real tokens to this file.
OTP_BRAND_NAME=SiPeNa
WHATSAPP_OTP_WEBHOOK_URL=
WHATSAPP_OTP_WEBHOOK_TOKEN=
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=

# Gmail SMTP
# SMTP_PASS must be a Google App Password, not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=
EMAIL_BRAND_NAME=SiPeNa

NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://localhost:4000
