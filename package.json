{
  "name": "sipena",
  "version": "2.5.0",
  "packageManager": "npm@11.7.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=11.7.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=inventory-frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "npm run lint --workspace=inventory-backend && npm run lint --workspace=inventory-frontend",
    "type-check": "npm run type-check --workspace=inventory-frontend",
    "test:backend": "npm run test --workspace=inventory-backend",
    "verify": "npm run lint && npm run build && npm run type-check && npm run test:backend",
    "test:selenium": "node selenium/support/clean-screenshots.mjs && node --test --test-concurrency=1 selenium/e2e/*.test.mjs",
    "test:selenium:headed": "SELENIUM_HEADLESS=false npm run test:selenium",
    "test:selenium:core": "node selenium/support/clean-screenshots.mjs && node --test --test-concurrency=1 selenium/e2e/full-regression.test.mjs",
    "test:selenium:core:headed": "SELENIUM_HEADLESS=false npm run test:selenium:core",
    "test:selenium:smoke": "node selenium/support/clean-screenshots.mjs && node --test --test-concurrency=1 selenium/e2e/navigation-smoke.test.mjs",
    "test:selenium:smoke:headed": "SELENIUM_HEADLESS=false npm run test:selenium:smoke",
    "test:selenium:matrix": "node selenium/support/clean-screenshots.mjs && node --test --test-concurrency=1 selenium/e2e/asset-status-matrix.test.mjs",
    "test:selenium:matrix:headed": "SELENIUM_HEADLESS=false npm run test:selenium:matrix",
    "selenium:smoke:headed": "npm run test:selenium:smoke:headed",
    "bootstrap:test-admin": "npm run bootstrap:test-admin --workspace=inventory-backend",
    "start": "sh scripts/start-production.sh",
    "configure:notifications": "sh scripts/configure-notification-channels.sh",
    "dev:backend": "npm run dev --workspace=inventory-backend",
    "build:backend": "npm run build --workspace=inventory-backend",
    "build:frontend": "npm run build --workspace=inventory-frontend",
    "migrate:user-security-columns": "npm run migrate:user-security-columns --workspace=inventory-backend",
    "start:backend": "npm run start --workspace=inventory-backend",
    "start:frontend": "npm run start --workspace=inventory-frontend -- --hostname 0.0.0.0 --port ${PORT:-3000}",
    "dev:all": "npm run dev --workspaces"
  },
  "overrides": {
    "@types/node": "20.19.27",
    "typescript": "5.9.3",
    "postcss": "8.5.23",
    "uuid": "11.1.1",
    "brace-expansion": "1.1.18",
    "dompurify": "3.4.13",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "sharp": "0.35.3",
    "next@16.2.6": {
      "postcss": "8.5.23"
    },
    "exceljs@4.1.1": {
      "uuid": "11.1.1"
    },
    "minimatch": "^3.1.5",
    "test-exclude": {
      "minimatch": "^3.1.5"
    },
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "selenium-webdriver": "^4.46.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@types/sequelize": "^4.28.20",
    "axios": "^1.13.2",
    "eslint": "^9.0.0",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  }
}
