{
  "name": "sipena",
  "version": "2.5.0",
  "packageManager": "npm@11.7.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=11.7.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=inventory-frontend",
    "build": "npm run build --workspace=inventory-frontend",
    "start": "npm run start --workspace=inventory-frontend",
    "dev:backend": "npm run dev --workspace=inventory-backend",
    "build:backend": "npm run build --workspace=inventory-backend",
    "start:backend": "npm run start --workspace=inventory-backend",
    "dev:all": "npm run dev --workspaces"
  },
  "overrides": {
    "@types/node": "20.19.27",
    "typescript": "5.9.3",
    "minimatch": "^3.1.5",
    "test-exclude": {
      "minimatch": "^3.1.5"
    }
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@types/sequelize": "^4.28.20",
    "axios": "^1.13.2",
    "eslint": "^9.0.0",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  }
}
