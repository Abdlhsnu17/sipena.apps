# NEVER COMMIT DATABASE DATA
# ==========================
*.sql
*.dump
*.mysql
!database/seeders/**/*.sql
backup/
backups/
database-backup/
db-backup/
*.sqlite

# ==========================
# Docker local data
# ==========================
docker-data/
*.tar

