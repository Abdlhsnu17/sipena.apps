selenium/screenshots/
selenium/reports/
selenium.env.json
playwright-report/
test-results/
blob-report/
.nyc_output/
report.*.json

# ==========================
# Environment variables
# NEVER COMMIT THESE FILES
# ==========================
.env
.env.*
!.env.example
.docker.env
.docker.env.local

# ==========================
# Logs
# ==========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

