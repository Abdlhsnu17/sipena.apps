# PHP / Laravel
# ==========================
/vendor
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
.phpunit.result.cache
/.phpunit.cache
/auth.json
Homestead.json
Homestead.yaml

# ==========================
# Dependencies
# ==========================
/node_modules
**/node_modules/

# ==========================
