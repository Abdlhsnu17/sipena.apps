# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==========================
# Dependencies
# ==========================
node_modules/
**/node_modules/


# ==========================
# Build outputs
# ==========================
dist/
build/
out/
.next/
coverage/


# ==========================
# Test outputs
# ==========================
playwright-report/
test-results/
blob-report/
.nyc_output/

selenium/screenshots/
selenium/reports/
selenium.env.json


# ==========================
# TypeScript cache
# ==========================
*.tsbuildinfo


# ==========================
# Environment variables
# NEVER COMMIT THESE FILES
# ==========================
.env
.env.*
!.env.example

.env.local
.env.development
.env.production
.env.test

.docker.env
.docker.env.local


# ==========================
# Logs
# ==========================
logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

report.*.json


# ==========================
# Runtime data
# ==========================
pids/
*.pid
*.seed
*.pid.lock


# ==========================
# Upload files
# NEVER COMMIT USER DATA
# ==========================
uploads/
apps/backend/uploads/
apps/*/uploads/

public/uploads/
storage/


# ==========================
# Database backup
# NEVER COMMIT DATABASE DATA
# ==========================
*.sql
*.dump
*.mysql

backup/
backups/
database-backup/
db-backup/


# ==========================
# Docker local data
# ==========================
docker-data/
*.tar


# ==========================
# Operating System files
# ==========================
.DS_Store
Thumbs.db
._*
.AppleDouble
.LSOverride

.Spotlight-V100/
.Trashes/


# ==========================
# Temporary files
# ==========================
*.tmp
*.temp
*.bak
*.bak.*
*.orig
*.rej


# ==========================
# IDE / Editor
# ==========================
.idea/
.vscode/

*.suo
*.ntvs*
*.njsproj
*.sln


# ==========================
# Local folders
