@startuml
title Activity Diagram Pemeliharaan Aset
skinparam shadowing false
skinparam activity {
  BackgroundColor #F8FAFF
  BorderColor #2F3B52
  ArrowColor #2F3B52
  DiamondBackgroundColor #F8FAFF
  DiamondBorderColor #2F3B52
}

|Petugas Pengelola Aset|
start
:Membuka menu Pemeliharaan Sarana;
:Mengajukan pemeliharaan aset
(preventif atau korektif) dan
menetapkan jadwal pemeliharaan;

|Sistem|
:Mengubah status aset menjadi
"Dalam Pemeliharaan";
:Mengirim notifikasi ke teknisi
yang ditugaskan;

|Teknisi|
:Mengerjakan pemeliharaan dan
memperbarui progres di lapangan;
if (Aset layak digunakan?) then (Tidak)
  :Menandai perlu pengecekan
  atau perbaikan lanjutan;
  stop
else (Ya)
endif
:Menandai pekerjaan selesai dikerjakan
(status completed);

|Administrator|
:Memvalidasi hasil pemeliharaan
(status validated);

|Sistem|
:Menyimpan riwayat pemeliharaan;
:Mengubah status aset menjadi "Tersedia";
:Menampilkan notifikasi pemeliharaan selesai;

|Petugas Pengelola Aset|
:Aset siap digunakan kembali;
stop
@enduml
