@startuml
title Activity Diagram Lupa Password
skinparam shadowing false
skinparam activity {
  BackgroundColor #F8FAFF
  BorderColor #2F3B52
  ArrowColor #2F3B52
  DiamondBackgroundColor #F8FAFF
  DiamondBorderColor #2F3B52
}

|Pengguna|
start
:Membuka halaman lupa password;
:Memasukkan email/nomor terdaftar;
:Menekan tombol "Kirim OTP";

|Sistem|
:Memeriksa akun terdaftar?;
if (Akun ditemukan?) then (Tidak)
  :Menampilkan pesan akun tidak ditemukan;
  |Pengguna|
  stop
else (Ya)
endif

|Sistem|
:Membuat kode OTP;
:Mengirim OTP melalui WhatsApp/email;

|Pengguna|
:Memasukkan kode OTP;

|Sistem|
if (OTP benar dan belum kedaluwarsa?) then (Tidak)
  :Menampilkan pesan OTP tidak valid;
  |Pengguna|
  stop
else (Ya)
endif

|Pengguna|
:Memasukkan password baru;

|Sistem|
:Mengenkripsi dan menyimpan password baru;
:Menampilkan notifikasi reset berhasil;

|Pengguna|
:Diarahkan ke halaman login;
stop
@enduml
