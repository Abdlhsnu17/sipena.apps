@startuml
title Gambar 3.15 Activity Diagram Arsip Riwayat Aktivitas
skinparam shadowing false
skinparam activity {
  BackgroundColor #F8FAFF
  BorderColor #2F3B52
  ArrowColor #2F3B52
  DiamondBackgroundColor #F8FAFF
  DiamondBorderColor #2F3B52
}

|Pengguna|
start
:Membuka menu Arsip Riwayat Aktivitas;
:Menentukan filter (tanggal, jenis aktivitas);

|Sistem|
:Mengambil data log aktivitas
sesuai hak akses pengguna;
if (Data tersedia?) then (Tidak)
  :Menampilkan informasi data kosong;
  |Pengguna|
  stop
else (Ya)
endif

|Sistem|
:Menampilkan daftar riwayat aktivitas
(waktu, aktor, aksi, modul);

|Pengguna|
:Menelusuri/melihat detail aktivitas;
stop
@enduml
