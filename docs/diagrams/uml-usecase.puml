    usecase "Tolak Peminjaman" as UC_RejectBorrowing
    usecase "Catat Pengembalian" as UC_ReturnBorrowing
    usecase "Validasi Pengembalian" as UC_ValidateReturn
    usecase "Perpanjang Jatuh Tempo" as UC_ExtendBorrowing
    usecase "Hapus Data Peminjaman" as UC_DeleteBorrowing
  }

  package "Penggunaan Aset" {
    usecase "Catat Penggunaan Aset" as UC_CreateUsage
    usecase "Lihat Log Penggunaan" as UC_ViewUsage
    usecase "Selesaikan Penggunaan" as UC_CompleteUsage
    usecase "Izin Penggunaan Darurat" as UC_EmergencyUsage
    usecase "Hapus Log Penggunaan" as UC_DeleteUsage
  }

  package "Pemeliharaan" {
    usecase "Buat Pemeliharaan Sarana" as UC_CreateMaintenance
    usecase "Lihat Daftar Pemeliharaan" as UC_ViewMaintenance
    usecase "Lihat Detail Pemeliharaan" as UC_MaintenanceDetail
    usecase "Ubah Data Pemeliharaan" as UC_EditMaintenance
    usecase "Selesaikan Pemeliharaan" as UC_CompleteMaintenance
    usecase "Kelola Lampiran Pemeliharaan" as UC_MaintenanceAttachment
    usecase "Kirim Pengingat Jadwal" as UC_DispatchReminder
    usecase "Kelola Riwayat Pemeliharaan" as UC_MaintenanceHistory
    usecase "Hapus Record Pemeliharaan" as UC_DeleteMaintenance
  }

  package "Sanksi Keterlambatan" {
    usecase "Lihat Statistik Sanksi" as UC_ViewSanction
    usecase "Selesaikan Sanksi" as UC_ResolveSanction
    usecase "Bebaskan Sanksi" as UC_WaiveSanction
  }

  package "Pemusnahan & Penghapusan" {
    usecase "Ajukan Pemusnahan Aset" as UC_RequestDisposal
    usecase "Putuskan Pemusnahan Aset" as UC_DecideDisposal
    usecase "Ajukan Penghapusan Data" as UC_RequestDeletion
    usecase "Putuskan Penghapusan Data" as UC_DecideDeletion
  }

  package "Laporan & Analitik" {
    usecase "Lihat Dashboard Laporan" as UC_ViewDashboard
    usecase "Lihat Laporan Aset" as UC_AssetReport
    usecase "Lihat Laporan Peminjaman" as UC_BorrowingReport
    usecase "Lihat Laporan Pemeliharaan" as UC_MaintenanceReport
    usecase "Hitung SPK Prioritas (AHP)" as UC_Dss
    usecase "Ekspor PDF" as UC_ExportPdf
    usecase "Ekspor Excel" as UC_ExportExcel
  }

  package "Dokumen Unggahan" {
    usecase "Unggah Dokumen" as UC_UploadReport
    usecase "Lihat Dokumen" as UC_ViewUploads
    usecase "Unduh Dokumen" as UC_DownloadUpload
    usecase "Pratinjau Dokumen" as UC_PreviewUpload
    usecase "Hapus Dokumen" as UC_DeleteUpload
  }

  package "Dokumentasi & Arsip" {
    usecase "Lihat Aktivitas Sendiri" as UC_ViewOwnActivity
    usecase "Lihat Seluruh Aktivitas" as UC_ViewAllActivity
    usecase "Akses Dokumentasi Sistem" as UC_ViewUML
  }

  package "Manajemen Pengguna" {
    usecase "Lihat Daftar Pengguna" as UC_ViewUsers
    usecase "Lihat Detail Pengguna" as UC_UserDetail
    usecase "Tambah Pengguna" as UC_AddUser
    usecase "Ubah Pengguna" as UC_EditUser
    usecase "Hapus Pengguna" as UC_DeleteUser
    usecase "Hapus Pengguna Massal" as UC_BulkDeleteUser
    usecase "Reset Password Pengguna" as UC_AdminResetPassword
    usecase "Atur Matriks Hak Akses Menu" as UC_AccessMatrix
  }
}

