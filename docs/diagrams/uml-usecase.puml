@startuml
title SIPENA Use Case Diagram
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFF
  BorderColor #2F3B52
  ArrowColor #2F3B52
}

actor "Pengguna Publik" as Guest
actor "Pengguna Terautentikasi" as Authenticated
actor Admin
actor Leader
actor "Staff PJ" as StaffPJ
actor "Staff Pelayanan" as Staff
actor Teknisi
actor Pengguna as User

Authenticated <|-- Admin
Authenticated <|-- Leader
Authenticated <|-- StaffPJ
Authenticated <|-- Staff
Authenticated <|-- Teknisi
Authenticated <|-- User

rectangle "SIPENA" {
  package "Autentikasi & Akun" {
    usecase "Login" as UC_Login
    usecase "Register" as UC_Register
    usecase "Reset Password" as UC_ResetPassword
    usecase "Verifikasi Kode OTP" as UC_VerifyOtp
    usecase "Logout" as UC_Logout
    usecase "Lihat Profil" as UC_ViewProfile
    usecase "Ubah Profil" as UC_EditProfile
    usecase "Ubah Password Sendiri" as UC_ChangePassword
  }

  package "Notifikasi" {
    usecase "Lihat Notifikasi" as UC_ViewNotification
    usecase "Tandai Notifikasi Dibaca" as UC_ReadNotification
    usecase "Hapus Notifikasi" as UC_DeleteNotification
  }

  package "Inventaris Aset" {
    usecase "Lihat Daftar Aset" as UC_ViewAssets
    usecase "Cari dan Filter Aset" as UC_SearchAssets
    usecase "Lihat Detail Aset" as UC_AssetDetail
    usecase "Pindai QR Aset" as UC_ScanAsset
    usecase "Tambah Aset" as UC_AddAsset
    usecase "Ubah Aset" as UC_EditAsset
    usecase "Impor Aset Massal" as UC_ImportAsset
    usecase "Hapus Aset" as UC_DeleteAsset
    usecase "Reset Inventaris" as UC_ResetInventory
  }

  package "Peminjaman & Pengembalian" {
    usecase "Ajukan Peminjaman" as UC_CreateBorrowing
