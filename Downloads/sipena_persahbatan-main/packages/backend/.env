# Server
PORT=4000
NODE_ENV=development
# Comma-separated list for CORS origins (e.g. http://localhost:3000,http://127.0.0.1:3000)
FRONTEND_URL=http://localhost:3000

# Database lokal
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sipena_db_local
DATABASE_URL="mysql://root:@localhost:3306/sipena_db_local"

# ganti sesuai user MySQL lokal Anda (contoh: root)
DB_USER=root
# ganti dengan password user tersebut (kosongkan jika tidak ada)
DB_PASSWORD=

# Security
JWT_SECRET=your_jwt_secret_here

# Redis (jika dipakai)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
