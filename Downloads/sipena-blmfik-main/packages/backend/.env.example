# Backend Environment Variables
#
# Copy this file to packages/backend/.env for local development.
# Production values must be set explicitly and should not reuse these defaults.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sipena_db_local
DB_USER=root
DB_PASSWORD=

# Generate a stronger value for shared or production environments.
JWT_SECRET=sipena-local-dev-jwt-secret-from-env

# Optional Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
