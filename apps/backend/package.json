{
  "name": "inventory-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Inventory and Maintenance System",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "migrate": "tsx src/scripts/run-migrations.ts",
    "migrate:user-security-columns": "tsx scripts/migrate-user-security-columns.ts",
    "report:users-without-phone": "tsx scripts/report-users-without-phone.ts",
    "check:twilio": "tsx scripts/check-twilio-verify.ts",
    "bootstrap:test-admin": "node scripts/bootstrap-test-admin.mjs",
    "bootstrap:test-admin:docker": "node ../../scripts/bootstrap-test-admin.mjs",
    "migrate:prod": "node dist/scripts/run-migrations.js",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "joi": "18.2.3",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "mysql2": "3.23.3",
    "nodemailer": "9.0.5",
    "redis": "6.2.1",
    "sequelize-typescript": "2.1.6",
    "swagger-ui-express": "5.0.1",
    "twilio": "6.1.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
