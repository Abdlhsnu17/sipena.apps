@startuml
title SIPENA Backend Domain Diagram
skinparam classAttributeIconSize 0

package "Models" {
  class Asset {
    +id: number
    +assetCode: string
    +name: string
    +category: string
    +type: AssetType
    +status: AssetStatus
    +condition: AssetCondition
    +location: string
    +purchaseDate: Date
    +specifications: Record
  }

  class Borrowing {
    +id: number
    +borrowingCode: string
    +assetId: number
    +assetType: AssetType
    +userId: number
    +borrowDate: Date
    +dueDate: Date
    +returnDate: Date
    +status: BorrowingStatus
    +purpose: string
  }

  class Maintenance {
    +id: number
    +maintenanceCode: string
    +assetId: number
    +assetType: AssetType
    +type: MaintenanceType
    +status: MaintenanceStatus
    +scheduledDate: Date
    +completedDate: Date
    +cost: number
  }

  class MaintenanceHistory {
    +id: number
    +maintenanceId: number
    +assetId: number
    +type: MaintenanceType
    +status: MaintenanceStatus
    +scheduledDate: Date
    +completedDate: Date
    +validatedAt: Date
  }

  class User {
    +id: number
    +nip: string
    +name: string
    +email: string
    +role: UserRole
    +staffAccessType: StaffAccessType
    +photoPath: string
    +umlAccess: boolean
  }

  class ReportUpload {
    +id: number
    +userId: number
    +filename: string
    +contentType: string
    +sizeBytes: number
    +storedPath: string
    +uploadedAt: Date
  }

  class UserActivity {
    +id: number
    +userId: number
    +feature: string
    +action: string
    +description: string
    +createdAt: Date
  }
}

package "Controllers" {
  class AssetController
  class AuthController
  class BorrowingController
  class MaintenanceController
  class MaintenanceHistoryController
  class ReportController
  class UserActivityController
  class UserController
}

package "Services" {
  class AssetService
  class BorrowingService
  class MaintenanceService
  class MaintenanceHistoryService
  class ReportService
  class UserActivityService
  class UserService
}

package "Routes" {
  class AuthRoutes <<router>>
  class AssetRoutes <<router>>
  class BorrowingRoutes <<router>>
  class MaintenanceRoutes <<router>>
  class MaintenanceHistoryRoutes <<router>>
  class ReportRoutes <<router>>
  class UmlRoutes <<router>>
  class UserActivityRoutes <<router>>
  class UserRoutes <<router>>
}

Asset "1" -- "*" Borrowing : digunakan
Asset "1" -- "*" Maintenance : dipelihara
Asset "1" -- "*" MaintenanceHistory : direkam
Maintenance "1" -- "*" MaintenanceHistory : memiliki riwayat
User "1" -- "*" Borrowing : meminjam
User "1" -- "*" Maintenance : membuat / memantau
User "1" -- "*" MaintenanceHistory : validasi
User "1" -- "*" ReportUpload : unggah
User "1" -- "*" UserActivity : aktivitas

note right of User
  Role aktif:
  admin, leader, staff,
  staff_pj, teknisi, user
end note

note right of Maintenance
  Terminologi status:
  in_progress = sedang pengecekan lanjutan
  completed = dalam proses pengerjaan
  validated = selesai pemeliharaan sarana
end note

AssetController ..> AssetService
AuthController ..> UserService
BorrowingController ..> BorrowingService
MaintenanceController ..> MaintenanceService
MaintenanceHistoryController ..> MaintenanceHistoryService
ReportController ..> ReportService
UserActivityController ..> UserActivityService
UserController ..> UserService

AuthRoutes ..> AuthController
AssetRoutes ..> AssetController
BorrowingRoutes ..> BorrowingController
MaintenanceRoutes ..> MaintenanceController
MaintenanceHistoryRoutes ..> MaintenanceHistoryController
ReportRoutes ..> ReportController
UmlRoutes ..> AuthController
UserActivityRoutes ..> UserActivityController
UserRoutes ..> UserController

@enduml
