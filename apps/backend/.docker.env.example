# Docker Compose environment variables for SiPeNa
#
# Copy this file to docker/.env for production-like runs with Docker Compose.
# Keep the real docker/.env out of git.

NODE_ENV=production
MYSQL_ROOT_PASSWORD=changeme-change-me
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=1
GENERAL_RATE_LIMIT_MAX=10000
LOGIN_RATE_LIMIT_MAX=40
REGISTER_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=20
UPLOADS_ROOT=/app/apps/backend/uploads

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_KEEP_ALIVE_INITIAL_DELAY_MS=0
ALLOW_IN_MEMORY_PASSWORD_RESET_STORE=false
DB_AUTO_INIT_FROM_SCHEMA=false

DB_HOST=mysql
DB_PORT=3306
DB_NAME=sipena_db_local
DB_USER=sipena_app
DB_PASSWORD=

JWT_SECRET=sipena-change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

OTP_BRAND_NAME=SiPeNa
WHATSAPP_OTP_WEBHOOK_URL=
WHATSAPP_OTP_WEBHOOK_TOKEN=
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=noreply@sipena.id
EMAIL_BRAND_NAME=SiPeNa

PHPMYADMIN_HOST_PORT=8081
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://backend:4000
