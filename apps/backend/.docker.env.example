# Docker-specific environment variables
# DO NOT commit this file to version control
# Copy this to .docker.env and update with your values

# MySQL Configuration
MYSQL_ROOT_PASSWORD=generate_a_strong_password_here
MYSQL_DATABASE=sipena_db_local
MYSQL_USER=sipena_app
MYSQL_PASSWORD=generate_a_strong_password_here

# Backend Configuration
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://app.example.com
API_PROXY_TIMEOUT_MS=8000
TRUST_PROXY_HOPS=1
GENERAL_RATE_LIMIT_MAX=2000
LOGIN_RATE_LIMIT_MAX=40
REGISTER_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=20
ALLOW_IN_MEMORY_PASSWORD_RESET_STORE=false
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sipena_db_local
DB_USER=sipena_app
DB_PASSWORD=generate_a_strong_password_here
# Set true only when you want to initialize an empty database from packages/db/seeds/schema.sql.
DB_AUTO_INIT_FROM_SCHEMA=false
# Optional: set false for local test admin accounts so E2E can land on the dashboard immediately.
INITIAL_ADMIN_MUST_CHANGE_PASSWORD=true

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_strong_secret_key_here_minimum_32_characters

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SSE_TICKET_TTL_SECONDS=30

# phpMyAdmin
PMA_HOST=mysql
PMA_PORT=3306
PMA_USER=root
PMA_PASSWORD=generate_a_strong_password_here

# Frontend
# Leave NEXT_PUBLIC_API_URL empty to force the Next.js internal proxy (/api -> backend).
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://backend:4000
FRONTEND_NODE_ENV=production
