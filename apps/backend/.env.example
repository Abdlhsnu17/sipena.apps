# Backend Environment Variables
#
# Copy this file to packages/backend/.env for local development.
# Production values must be set explicitly and should not reuse these defaults.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_PROXY_TIMEOUT_MS=8000
TRUST_PROXY_HOPS=1
GENERAL_RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=20
REGISTER_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=10
UPLOADS_ROOT=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_KEEP_ALIVE_INITIAL_DELAY_MS=0
ALLOW_IN_MEMORY_PASSWORD_RESET_STORE=true

# Bootstraps exactly one admin account on first startup, only if the `users` table has
# no admin yet. Required for a brand new install since the public register endpoint can
# never create an admin. Ignored (and safe to leave unset) once an admin account exists.
INITIAL_ADMIN_NIP=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PHONE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sipena_db_local
DB_USER=root
DB_PASSWORD=
# Set true only when you want to initialize an empty database from packages/db/seeds/schema.sql.
DB_AUTO_INIT_FROM_SCHEMA=false

# Generate a stronger value for shared or production environments.
JWT_SECRET=sipena-local-dev-jwt-secret-from-env

# Optional Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional OTP webhooks
OTP_BRAND_NAME=SiPeNa
WHATSAPP_OTP_WEBHOOK_URL=
WHATSAPP_OTP_WEBHOOK_TOKEN=
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=

# Optional phone notifications for maintenance and other operational events
NOTIFICATION_BRAND_NAME=SiPeNa
WHATSAPP_NOTIFICATION_WEBHOOK_URL=
WHATSAPP_NOTIFICATION_WEBHOOK_TOKEN=
SMS_NOTIFICATION_WEBHOOK_URL=
SMS_NOTIFICATION_WEBHOOK_TOKEN=

# Optional SMTP Email Notifications
# Leave blank to disable email notifications (system will log to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sipena.id
EMAIL_BRAND_NAME=SiPeNa
