# Backend Environment Variables
#
# Copy this file to packages/backend/.env for local development.
# Production values must be set explicitly and should not reuse these defaults.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_PROXY_TIMEOUT_MS=8000
TRUST_PROXY_HOPS=1
GENERAL_RATE_LIMIT_MAX=10000
LOGIN_RATE_LIMIT_MAX=40
REGISTER_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=20
UPLOADS_ROOT=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000
DB_KEEP_ALIVE_INITIAL_DELAY_MS=0
ALLOW_IN_MEMORY_PASSWORD_RESET_STORE=true

# Bootstraps exactly one admin account on first startup, only if the `users` table has
# no admin yet. Required for a brand new install since the public register endpoint can
# never create an admin. Ignored (and safe to leave unset) once an admin account exists.
INITIAL_ADMIN_NIP=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PHONE=
# Optional: keep false for test accounts that should land directly on the dashboard.
INITIAL_ADMIN_MUST_CHANGE_PASSWORD=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sipena_db_local
DB_USER=root
DB_PASSWORD=
# Set true only when you want to initialize an empty database from packages/db/seeds/schema.sql.
DB_AUTO_INIT_FROM_SCHEMA=false

# Generate a stronger value for shared or production environments.
JWT_SECRET=sipena-local-dev-jwt-secret-from-env

# Optional Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
SSE_TICKET_TTL_SECONDS=30

# Masa berlaku cache dataset SPK (ms). 0 mematikan cache.
DSS_DATASET_CACHE_TTL_MS=60000

# Twilio Verify: kanal OTP utama untuk reset password bila ketiganya diisi.
# Twilio yang membuat, mengirim, dan memvalidasi kodenya sehingga tidak ada OTP
# yang disimpan aplikasi. Kredensial ini hanya boleh ada di backend; jangan
# pernah memakai prefix NEXT_PUBLIC_ untuk nilai-nilai ini.
# TWILIO_VERIFY_CHANNEL: sms (default) atau whatsapp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

# Optional OTP webhooks (cadangan bila Twilio Verify tidak dikonfigurasi)
OTP_BRAND_NAME=SiPeNa
WHATSAPP_OTP_WEBHOOK_URL=
WHATSAPP_OTP_WEBHOOK_TOKEN=
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=

# Optional phone notifications for maintenance and other operational events
NOTIFICATION_BRAND_NAME=SiPeNa
WHATSAPP_NOTIFICATION_WEBHOOK_URL=
WHATSAPP_NOTIFICATION_WEBHOOK_TOKEN=
SMS_NOTIFICATION_WEBHOOK_URL=
SMS_NOTIFICATION_WEBHOOK_TOKEN=

# Optional SMTP Email Notifications
# Leave blank to disable email notifications (system will log to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=noreply@sipena.id
EMAIL_BRAND_NAME=SiPeNa
